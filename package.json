{
  "name": "nanoswarm",
  "version": "1.0.0-alpha.1",
  "description": "Particle swarms shaped by formulas, 3D models and sound — as one HTML element.",
  "author": "Eladio Mejuto",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eladiomejutogracia/nanoswarm.git"
  },
  "homepage": "https://github.com/eladiomejutogracia/nanoswarm#readme",
  "bugs": {
    "url": "https://github.com/eladiomejutogracia/nanoswarm/issues"
  },
  "type": "module",
  "module": "dist/nanoswarm.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/nanoswarm.js"
    },
    "./element": {
      "default": "./dist/nano-swarm.js"
    }
  },
  "unpkg": "dist/nano-swarm.js",
  "jsdelivr": "dist/nano-swarm.js",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode lib && vite build --mode element && npm run build:check && tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:check": "vite build --mode check",
    "check": "node .claude/skills/nanoswarm/check.mjs"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "keywords": [
    "particles",
    "threejs",
    "webgl",
    "audio-visualizer",
    "parametric",
    "formula"
  ]
}
